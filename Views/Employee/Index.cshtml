
@model List<MB_2.Models.OutPutEmployeeList>

<h1>Employees</h1>
<button>
    <a href="/Employee/Create">Create Employee</a>
</button>


<hr />
<form method="get" action="/Employee/index">

    <input type="text" name="searchname"  placeholder="Search by name..." />
    
    <select name="Namesort"> 
        <option value="">Sort By </option>
        <option value="ASC">ASC </option>
        <option value="DESC">DESC</option>
    </select> 

    <select name="filteractive">
        <option value="">All</option>
        <option value="true">Active</option>
        <option value="false">DeActive</option>

    </select>
     
    <button type="submit">Apply</button>
    <a href="/Employee/Index">Clear</a>
    <button type="button" onclick="window.location.href='/Employee/index'">
        Clear All
    </button>


</form>

<h2>Employee List</h2>

<table border="2" width="2">
    <thead >
        <tr >
            <th>Slno</th>
            <th>Name</th>
            <th>Is Active</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Join Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model==null || !Model.Any())
        {
            <tr >
                <td align="center" colspan="18">No data</td>
            </tr>
        }

        @foreach (var employee in Model)
        {



            <tr>
                <td>@employee.FK_Employee</td>

                <td>@employee.Name</td>

                <td>
                    @(employee.IsActive ? "Active" : "Inactive")
                </td>

                <td>@employee.Email</td>
                <td>@employee.Phone</td>
                <td>@employee.Department</td>
                <td>@employee.Designation</td>
                <td>@employee.JoinDate</td>

                <td>
                    <button>
                        <a href="/Employee/Edit?id=@employee.FK_Employee">
                        Edit
                        </a>
                    </button>
                    

                    <form action="/Employee/Delete"
                          method="post"
                          style="display:inline;">

                        <input type="hidden"
                               name="FK_Employee"
                               value="@employee.FK_Employee" />

                        <button type="submit">
                            Delete
                        </button>

                    </form>
                </td>
            </tr>
        }
    </tbody>
    
</table>
<div>

    @if (ViewBag.Page > 1)
    {
        <a href="/Employee/Index?page=@(ViewBag.Page - 1)">
            Previous
        </a>
    }

    <span> Page @ViewBag.Page </span>

    <a href="/Employee/Index?page=@(ViewBag.Page + 1)">
        Next
    </a>
    <select onchange="window.location.href='/Employee/Index?page=1&pagesize=' + this.value">
        <option value="">Select Page Size</option>
        <option value="2">2</option>
        <option value="6">6</option>
        <option value="7">7</option>
        <option value="8">8</option>
    </select>

</div>
<style>
    Table  {
        width:100%;
        border: 1px solid black;

    }   

    td,th {
        width :100px;
        border: 1px solid red;
        padding: 8px;

    }

</style>

