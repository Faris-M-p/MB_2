
@model List<MB_2.Models.OutPutEmployeeList>

<h1>Employees</h1>
<button>
    <a href="/Employee/Create">Create Employee</a>
</button>


<hr />

<h2>Employee List</h2>

<table border="2" width="2">
    <thead >
        <tr >
            <th>Slno</th>
            <th>Name</th>
            <th>Is Active</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Join Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model==null || !Model.Any())
        {
            <tr >
                <td align="center" colspan="18">No data</td>
            </tr>
        }

        @foreach (var employee in Model)
        {



            <tr>
                <td>@employee.FK_Employee</td>

                <td>@employee.Name</td>

                <td>
                    @(employee.IsActive ? "Active" : "Inactive")
                </td>

                <td>@employee.Email</td>
                <td>@employee.Phone</td>
                <td>@employee.Department</td>
                <td>@employee.Designation</td>
                <td>@employee.JoinDate</td>

                <td>
                    <a href="/Employee/Edit?id=@employee.FK_Employee">
                        Edit
                    </a>

                    <form action="/Employee/Delete"
                          method="post"
                          style="display:inline;">

                        <input type="hidden"
                               name="FK_Employee"
                               value="@employee.FK_Employee" />

                        <button type="submit">
                            Delete
                        </button>

                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    Table  {
        width:100%;
        border: 1px solid black;

    }   

    td,th {
        width :100px;
        border: 1px solid red;
        padding: 8px;

    }

</style>

